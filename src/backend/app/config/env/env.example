
# =========================
# APP CONFIGURATION
# =========================
APP_ENV=development
APP_NAME=Internal Business Strategic Platform
PORT=8000
DEBUG=true
API_V1_PREFIX=/api/v1

# =========================
# DATABASE CONFIGURATION
# PostgreSQL
# =========================
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=internal_business_strategic_platform
DB_HOST=db
DB_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/internal_business_strategic_platform

# =========================
# SECURITY CONFIGURATION
# =========================
# Add authentication secrets when the authentication design is finalized.

# =========================
# FRONTEND / CORS CONFIGURATION
# =========================
FRONTEND_URL=http://localhost:3000

# =========================
# TOOLS CONFIGURATION
# Docker Compose / pgAdmin
# =========================
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin
